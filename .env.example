# CivicWater Sentinel backend - configuration (no secrets). Copy to .env if you use one;
# the app itself reads the process environment.
SENTINEL_INTERVAL_SECONDS=300
# Past windows kept for the forecaster (288 = 24 h) and minimum contiguous past windows
# before scoring (144 = 12 h).
SENTINEL_HISTORY_CAPACITY=288
SENTINEL_MIN_HISTORY_WINDOWS=144
SENTINEL_REQUIRE_ALIGNED_TIMESTAMPS=true
# Timestamps without timezone: UTC (read as UTC, flagged) | reject (422).
SENTINEL_NAIVE_TIMESTAMP_TZ=UTC
# Results kept for idempotent resends (2016 = 7 days) and alerts kept in memory.
SENTINEL_RESULT_CAPACITY=2016
SENTINEL_ALERT_CAPACITY=10000
# Placeholder registry for dev/tests. Real data: the data owner's table, e.g.
# SENTINEL_SENSOR_REGISTRY=$SENTINEL_DATA_DIR/v1/sensors.csv
SENTINEL_SENSOR_REGISTRY=config/sensors.provisional.json
# Only "mock" exists today; any other value fails at startup on purpose.
SENTINEL_FORECASTER=mock
SENTINEL_DETECTOR=mock
# null | memory (memory = dev only, not tamper-evident)
SENTINEL_AUDIT_SINK=null
# Fail-closed audit: events waiting for the sink before new windows get 503 (ADR-006).
SENTINEL_AUDIT_PENDING_CAPACITY=2016
SENTINEL_MOCK_DETECTOR_SIGMA_M=1.0
SENTINEL_MOCK_DETECTOR_Z_THRESHOLD=3.0
SENTINEL_MOCK_DETECTOR_MIN_SENSORS=2
SENTINEL_METRICS_SAMPLE_SIZE=10000
SENTINEL_LOG_LEVEL=INFO
