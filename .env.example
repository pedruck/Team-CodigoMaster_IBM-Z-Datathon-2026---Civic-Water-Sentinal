# CivicWater Sentinel backend - configuration (no secrets). Copy to .env if you use one;
# the app itself reads the process environment.
SENTINEL_INTERVAL_SECONDS=300
# Past windows kept for the forecaster (288 = 24 h) and minimum contiguous past windows
# before scoring (144 = 12 h).
SENTINEL_HISTORY_CAPACITY=288
SENTINEL_MIN_HISTORY_WINDOWS=144
SENTINEL_REQUIRE_ALIGNED_TIMESTAMPS=true
# Timestamps without timezone: UTC (read as UTC, flagged) | reject (422).
SENTINEL_NAIVE_TIMESTAMP_TZ=UTC
# Results kept for idempotent resends (2016 = 7 days) and alerts kept in memory.
SENTINEL_RESULT_CAPACITY=2016
SENTINEL_ALERT_CAPACITY=10000
# Placeholder registry for dev/tests. Real data: the data owner's official registry
# SENTINEL_SENSOR_REGISTRY=config/sensors.battledim.json
SENTINEL_SENSOR_REGISTRY=config/sensors.provisional.json
# Write path (contracts §1). Bearer token for POST, at least 16 characters, given as a file
# (SENTINEL_INGEST_TOKEN_FILE, preferred: a value on a command line is visible in ps) or as the
# value itself in SENTINEL_INGEST_TOKEN (only in your own .env). Unset = open (development only).
# SENTINEL_INGEST_TOKEN_FILE=~/shared/civicwater/secrets/ingest-8000.token
SENTINEL_MAX_BODY_BYTES=65536
# A window more than this ahead of the last accepted one is refused (0 = no limit), and one
# later than the server clock + tolerance (ADR-004).
SENTINEL_MAX_GAP_SECONDS=86400
SENTINEL_FUTURE_TOLERANCE_SECONDS=3600
# mock | baseline | xgboost | gru. A real one needs its artefact and is loaded at startup;
# a load failure stops the API (no fallback to the mock, ADR-005). On the VM:
# SENTINEL_FORECASTER=xgboost
# SENTINEL_FORECASTER_PATH=/home/ibm-user/shared/civicwater/models/xgboost-33@0.1.0
SENTINEL_FORECASTER=mock
# XGBoost only: TreeSHAP contributions on_alert (default: only for the deviating sensors of an
# alert, after detection) | all (every sensor of every window, ~127 ms on the VM) | off
# (true/false still mean all/off); engine snapml | xgboost; Snap ML tree_format auto |
# compress_trees | zdnn_tensors (auto picks the NNPA on the VM).
SENTINEL_FORECASTER_CONTRIBUTIONS=on_alert
SENTINEL_FORECASTER_ENGINE=snapml
SENTINEL_FORECASTER_TREE_FORMAT=auto
# Optional pin of the artefact's SHA-256 (any other artefact stops startup). xgboost-33@0.1.0 on
# the VM: 808746bc30b30f4c6e35540edf8ee4cd696ae3e398e314217f2708cdc961c407
# SENTINEL_FORECASTER_SHA256=
# mock | cusum. cusum needs SENTINEL_DETECTOR_CALIBRATION (an artefact calibrated for the
# forecaster above, else startup fails) and optionally SENTINEL_DETECTOR_REGIONS (README).
SENTINEL_DETECTOR=mock
# With SENTINEL_DETECTOR=cusum (README, ADR-007/008/011): the calibration artefact is required;
# regions and pipe network are optional. L-Town: config/regions.battledim.json and the data
# owner's network file (kept outside git, next to the other data) together with the official
# sensor registry above.
# SENTINEL_DETECTOR_CALIBRATION=run/calibration.json
# SENTINEL_DETECTOR_REGIONS=config/regions.battledim.json
# SENTINEL_DETECTOR_NETWORK=$SENTINEL_DATA_DIR/network/v1/l-town.json
# null | memory (memory = dev only, not tamper-evident) | chain (hash-chained file, BE-013)
SENTINEL_AUDIT_SINK=null
# chain only: <dir>/<run>.jsonl and <dir>/<run>.explanations.jsonl; dir defaults to
# ~/shared/civicwater/audit. One run name per process.
# SENTINEL_AUDIT_RUN=local-test
# SENTINEL_AUDIT_DIR=data/audit
# chain only: who writes the stored explanations: none (deterministic text) | llamacpp | local | watsonx
SENTINEL_NARRATOR=none
# llamacpp (Granite GGUF in the API process) / local (llama.cpp server):
# LOCAL_LLM_MODEL_PATH=
# LOCAL_LLM_THREADS=1
# LOCAL_LLM_CTX=2048
# LOCAL_LLM_URL=
# LOCAL_LLM_MODEL=
# LOCAL_LLM_TIMEOUT_S=60
# watsonx (secrets: only in your own .env, never in git or on a command line):
# WATSONX_APIKEY=
# WATSONX_URL=
# WATSONX_PROJECT_ID=
# WATSONX_MODEL_ID=
# WATSONX_TIMEOUT_S=20
# Fail-closed audit: events waiting for the sink before new windows get 503 (ADR-006).
SENTINEL_AUDIT_PENDING_CAPACITY=2016
SENTINEL_MOCK_DETECTOR_SIGMA_M=1.0
SENTINEL_MOCK_DETECTOR_Z_THRESHOLD=3.0
SENTINEL_MOCK_DETECTOR_MIN_SENSORS=2
SENTINEL_METRICS_SAMPLE_SIZE=10000
SENTINEL_LOG_LEVEL=INFO
